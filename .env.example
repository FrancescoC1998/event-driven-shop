# Copia questo file in ".env" e cambia i valori.
# Il file .env NON va committato (è nel .gitignore).

# Superutente Postgres (amministrazione)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Password degli utenti dei singoli servizi
ORDERS_DB_PASSWORD=change-me
INVENTORY_DB_PASSWORD=change-me

# Porte esposte sul tuo PC
POSTGRES_PORT=5432
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8085
